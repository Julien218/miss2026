# === Database ===
DATABASE_URL=mysql://user:password@host:port/database

# === Authentication ===
JWT_SECRET=your-jwt-secret-here

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# === Object storage — Cloudflare R2 ===
# Requis pour les photos de candidature et les médias uploadés.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket
R2_PUBLIC_URL=https://your-public-r2-domain.example.com

# === Meta / WhatsApp Business ===
META_WHATSAPP_TOKEN=your-meta-whatsapp-token
META_WABA_ID=your-waba-id
META_PHONE_NUMBER_ID=your-phone-number-id

# === ElevenLabs (voice) ===
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# === FlowithOS Webhook ===
FLOWITHOS_WEBHOOK_SECRET=your-webhook-secret

# === OAuth externe (optionnel) ===
# Le login local email/mot de passe est la méthode canonique en production.
OAUTH_SERVER_URL=https://oauth.example.com
OWNER_OPEN_ID=your-owner-open-id

# === Forge API (optionnel / intégrations legacy) ===
# N'est plus utilisé pour le stockage de fichiers. Peut rester nécessaire pour
# certaines intégrations historiques, notamment l'envoi d'invitations.
BUILT_IN_FORGE_API_KEY=your-forge-api-key
BUILT_IN_FORGE_API_URL=https://forge-api.example.com

# === Vite Frontend (public, safe to expose) ===
VITE_APP_ID=your-app-id
VITE_PUBLIC_BASE_URL=https://missetmisterdour.be
VITE_FRONTEND_FORGE_API_URL=https://forge-api.example.com
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-api-key
VITE_OAUTH_PORTAL_URL=https://oauth.example.com

# === Runtime ===
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://missetmisterdour.be
