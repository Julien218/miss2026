# === Database ===
DATABASE_URL=mysql://user:password@host:port/database

# === Authentication ===
JWT_SECRET=your-jwt-secret-here

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# === Meta / WhatsApp Business ===
META_WHATSAPP_TOKEN=your-meta-whatsapp-token
META_WABA_ID=your-waba-id
META_PHONE_NUMBER_ID=your-phone-number-id

# === ElevenLabs (voice) ===
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# === FlowithOS Webhook ===
FLOWITHOS_WEBHOOK_SECRET=your-webhook-secret

# === OAuth ===
OAUTH_SERVER_URL=https://oauth.example.com
OWNER_OPEN_ID=your-owner-open-id

# === Forge API (Built-in) ===
BUILT_IN_FORGE_API_KEY=your-forge-api-key
BUILT_IN_FORGE_API_URL=https://forge-api.example.com

# === Vite Frontend (public, safe to expose) ===
VITE_APP_ID=your-app-id
VITE_PUBLIC_BASE_URL=https://missetmisterdour.be
VITE_FRONTEND_FORGE_API_URL=https://forge-api.example.com
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-api-key
VITE_OAUTH_PORTAL_URL=https://oauth.example.com

# === Runtime ===
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://missetmisterdour.be
